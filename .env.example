# Environment variables this app reads. Copy the names into Replit Secrets and
# fill in real values there — do not commit a populated .env.

# --- Core ---
DATABASE_URL=
SESSION_SECRET=
APP_BASE_URL=https://orderlyai.studio
PORT=5000

# --- Voice: Retell ---
# Retell is the production call path. Inbound goes:
#   PSTN -> Twilio -> Elastic SIP Trunk -> Retell -> agent
RETELL_API_KEY=

# Your Twilio trunk's TERMINATION SIP URI. Retell dials out through this.
# Twilio Console > Elastic SIP Trunking > <trunk> > Termination.
# No spaces — Retell rejects a URI containing one.
RETELL_TERMINATION_URI=joya-support-network.pstn.twilio.com

# The SID of that trunk (starts with TK). Numbers are attached to it on
# purchase so inbound calls actually reach Retell.
# Twilio Console > Elastic SIP Trunking > <trunk> — shown as "Trunk SID".
TWILIO_TRUNK_SID=

# Where Twilio sends INBOUND trunk calls. Retell issues an account-specific
# host, so do not use the generic sip:sip.retellai.com from their docs.
# Twilio Console > Elastic SIP Trunking > <trunk> > Origination.
RETELL_ORIGINATION_URI=sip:5t4n6j0wnrl.sip.livekit.cloud

# --- Telephony: Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ADMIN_SMS_NUMBER=

# --- POS: Square ---
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
SQUARE_OAUTH_REDIRECT_URI=

# --- POS: Toast ---
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_OAUTH_REDIRECT_URI=

# --- Billing: Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_STANDARD_PRICE_ID=
STRIPE_PROFESSIONAL_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# --- Other services ---
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=
